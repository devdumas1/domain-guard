ite recovers or Raia resolves it.';\n} else if (!fix) {\n  note = d.fix_summary\n    ? esc(d.fix_summary)\n    : 'Domain Guard has no automatic fix for this request, so carry out the approved change manually. The scheduled monitor will verify the site afterwards.';\n} else {\n  result = fix.error ? 'failed' : String(fix.result ?? 'failed');\n  const message = fix.error ? 'The apply-fix workflow could not run (' + (fix.error.message || fix.error) + ').' : String(fix.message ?? '');\n  if (result === 'applied') note = '<b>Applied in Cloudflare:</b> ' + esc(message) + ' Raia will re-check the domain now. To undo: ' + esc(fix.undo);\n  else if (result === 'already_present') note = esc(message) + ' Raia will re-check the domain now.';\n  else note = '<b>The change was not applied:</b> ' + esc(message) + ' Make the change by hand, or connect Cloudflare and request it again.';\n}\nreturn [{ json: { page_note: note, fix_result: result, verify: result === 'applied' || result === 'already_present', domain: d.domain, summary: d.fix_summary } }];"},"name":"Fix outcome","type":"n8n-nodes-base.code","typeVersion":2,"position":[976,-48],"id":"33fca7df-fcb1-4127-acf3-48107b406a19"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"verify-fix","leftValue":"={{ $('Fix outcome').first().json.verify }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"name":"Verify fix?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1424,-48],"id":"6a0bf774-6c49-4a34-aa14-b94f3d25602a"},{"parameters":{"method":"POST","url":"https://your-instance.app.n8n.cloud/webhook/domain-guard-incident","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ domain: $('Fix outcome').first().json.domain, event_type: 'FIX_APPLIED', details: 'An approved change was