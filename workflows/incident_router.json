g(),\n  'Conversation ID': b.conversationId || '',\n  'Title': b.title || '',\n  'Source': b.conversationSource || '',\n  'Final Status': statuses.length ? statuses[statuses.length - 1] : 'none',\n  'Messages': msgs.length,\n  'Score': b.score ?? '',\n  'Thumbs Up': feedback.filter(f => f.voteType === 'up').length,\n  'Thumbs Down': feedback.filter(f => f.voteType === 'down').length,\n  'Feedback Comments': feedback.map(f => f.comment).filter(Boolean).join(' | '),\n  'Summary': b.summary || '',\n  'Last Response': (assistantText[assistantText.length - 1] || '').slice(0, 5000),\n} }];"},"name":"Summarize conversation","type":"n8n-nodes-base.code","typeVersion":2,"position":[-368,-896],"id":"8d2c6985-4940-4d82-b065-64ed771cf354"},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"YOUR_GOOGLE_SHEET_ID","mode":"list","cachedResultName":"Domain Guard","cachedResultUrl":"https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"Conversations","mode":"name"},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":[],"schema":[]},"options":{}},"name":"Log conversation","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-128,-896],"id":"43c7ccf1-2805-4884-a12e-912090f32ac8","credentials":{"googleSheetsOAuth2Api":{"id":"d5F1pGXVD85dxTHH","name":"Google Sheets account"}}},{"parameters":{"jsCode":"// Open an approval request: a unique ID plus a random token that the\n// Approve/Reject links must carry. The row in the Approvals tab is the record.\n// A FIX line in Raia's reply is the exact DNS change that Approve will apply.\nconst randomPart = () => Math.random().toString(36).slice(2, 10);\nconst id = 'DG-' + Date.now().toString(36).toUpperCase() + '-' + randomPart().slice(0, 4).toUpperCase();\nconst token = randomPart() + randomPart() + randomPart() + randomPart();\nconst response = String($('raia').first().json.response || '');\nconst fixLine = (response.match(/^\\s*FIX:\\s*(\\{.*\\})\\s*$/m) || [])[1];\nlet fix = '';\nlet fixSummary = '';\nif (fixLine) {\n  try {\n    const f = JSON.parse(fixLine);\n    const type = String(f.type ?? '').toUpperCase();\n    fix = JSON.stringify(f);\n    fixSummary = String(f.action ?? '') + ' the ' + type + ' record ' + String(f.name ?? '') + ' = '\n      + (type === 'MX' && f.priority != null ? f.priority + ' ' : '') + String(f.content ?? '')\n      + (f.old_content ? ' (replacing ' + f.old_content + ')' : '');\n  } catch (e) {\n    fixSummary = 'Raia attached a fix that could not be read, so approving will not change anything automatically.';\n  }\n}\nreturn [{ json: {\n  'Approval ID': id,\n  'Token': token,\n  'Status': 'Pending',\n  'Requested At': new Date().toISOString(),\n  'Domain': $('Edit Fields').first().json.domain,\n  'Event Type': $('Edit Fields').first().json.event_type,\n  'Proposed Action': response,\n  'Decided At': '',\n  'Decision Note': '',\n  'Incident ID': $('Match incident').first().json.incident_id,\n  'Fix': fix,\n  'Fix Summary': fixSummary,\n  'Fix Result': '',\n} }];"},"name":"Create approval","type":"n8n-nodes-base.code","typeVersion":2,"position":[688,-816],"id":"6af8f8dd-02a0-45d1-a67e-c26458330bba"},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"YOUR_GOOGLE_SHEET_ID","mode":"list","cachedResultName":"Domain Guard","cachedResultUrl":"https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"Approvals","mode":"name"},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":[],"schema":[{"id":"Approval ID","displayName":"Approval ID","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Token","displayName":"Token","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Status","displayName":"Status","required":false,"defaultMatch":false,"display":tr