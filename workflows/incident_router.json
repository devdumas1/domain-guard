lly. The scheduled monitor will verify the site afterwards.' : 'No change will be made. The incident stays open until the site recovers or Raia resolves it.') + '</p>' + '</body></html>' }}","contentTypeNotice":"","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}}},"name":"Show result","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[80,-48],"id":"5dbe390b-3a12-43b4-8aaa-4bdb2f049ba8"},{"parameters":{"generalNotice":"","respondWith":"text","webhookNotice":"","responseBody":"={{ '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Domain Guard approval</title></head><body style=\"font-family:-apple-system,Segoe UI,sans-serif;max-width:560px;margin:40px auto;padding:0 16px;color:#1f2328\">' + '<h2>Not recorded</h2><p>' + $json.message + '</p>' + '</body></html>' }}","contentTypeNotice":"","options":{"responseCode":400,"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/html; charset=utf-8"}]}}},"name":"Show error","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[-176,112],"id":"054719e4-6992-4673-be09-3a353669ae54"},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"read","documentId":{"__rl":true,"value":"YOUR_GOOGLE_SHEET_ID","mode":"list","cachedResultName":"Domain Guard","cachedResultUrl":"https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"Incident Log","mode":"name"},"filtersUI":{},"combineFilters":"AND","options":{}},"name":"Find open incident","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[-320,-736],"id":"8f4b0401-3518-4418-a5a2-f722c6afe1c4","credentials":{"googleSheetsOAuth2Api":{"id":"d5F1pGXVD85dxTHH","name":"Google Sheets account"}},"onError":"continueRegularOutput","alwaysOutputData":true},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// Attach this alert to the domain's open incident, or open a new one. An\n// incident stays open until Raia resolves it, so repeat alerts update one row.\nconst ev = $('Edit Fields').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r['Incident ID'] && r['Domain'] === ev.domain && r['Status'] !== 'Resolved');\nconst open = rows[rows.length - 1];\nif (open) {\n  return [{ json: { ...ev, incident_id: open['Incident ID'], is_new: false, opened_at: open['Opened At'], last_status: open['Status'], updates: Number(open['Updates']) || 1, event_types: String(open['Event Types'] || '') } }];\n}\nconst stamp = new Date().toISOString().slice(0, 10).replace(/-/g, '');\nconst id = 'INC-' + stamp + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\nreturn [{ json: { ...ev, incident_id: id, is_new: true, opened_at: new Date().toISOString(), last_status: '', updates: 0, event_types: '' } }];","notice":""},"name":"Match incident","type":"n8n-nodes-base.code","typeVersion":2,"position":[-96,-736],"id":"eb51c4bf-8033-495a-a0c1-4ea0896ddcf5"},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"// One row per incident in the Incident Log tab: opened on the first alert,\n// updated on every later one, and closed when Raia resolves it.\nconst m = $('Match incident').first().json;\nconst response = String($input.first().json.response || '');\nconst statuses = [...response.matchAll(/STATUS:\\s*(Resolved|Investigating|Awaiting Approval|Escalated)/g)].map(s => s[1]);\n// A reply without a status line goes to the escalation email, so record it as escalated.\nconst status = statuses.length ? statuses[statuses.length - 1] : 'Escalated';\nconst now = new Date();\nconst events = [...new Set([...m.event_types.split(', ').filter(Boolean), m.event_type])];\nconst resolved = status === 'Resolved';\nreturn [{ json: {\n  'Incident ID': m.incident_id,\n  'Domain': m.domain,\n  'Status': status,\n  'Opened At': m.opened_at,\n  'Last Update': now.toISOString(),\n  'Updates': m.updates + 1,\n  'Event Types': events.join(', '),\n  'Latest Diagnosis': response.slice(0, 5000),\n  'Resolved At': resolved ? now.toISOString() : '',\n  'Minutes Open': resolved ? Math.round((now - new Date(m.opened_at)) / 60000) : '',\n} }];","notice":""},"name":"Prepare incident row","type":"n8n-nodes-base.code","typeVersion":2,"position":[368,-320],"id":"f890809a-854e-4d5c-85b3-8fe94455e69d"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"5e1f2a7c-0b7e-4c55-9d1e-6a0f3c1b2d41","leftValue":"={{ $('Match incident').first().json.is_new }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"looseTypeValidation":false,"options":{}},"name":"New incident?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[592,-320],"id":"d7cfd087-53ab-45e8-86ed-a88bdd151b21"},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"append","documentId":{"__rl":true,"value":"YOUR_GOOGLE_SHEET_ID","mode":"list","cachedResultName":"Domain Guard","cachedResultUrl":"https://docs.google.com/spreadsheets/d/YOUR_GOOGLE_SHEET_ID/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"Incident Log","mode":"name"},"columns":{"mappingMode":"autoMapInputData","value":{},"matchingColumns":[],"schema":[{"id":"Incident ID","displayName":"Incident ID","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Domain","displayName":"Domain","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Status","displayName":"Status","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Opened At","displayName":"Opened At","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"Last Upd