"d5F1pGXVD85dxTHH","name":"Google Sheets account"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"// Add the domain's row from the Domains tab (purpose, criticality and expected\n// configuration) so Raia can compare live results with what is expected.\nconst m = $('Match incident').first().json;\nconst row = $input.all().map(i => i.json).find(r => String(r.Domain ?? '').trim().toLowerCase() === String(m.domain).trim().toLowerCase()) || {};\nconst fields = ['Purpose', 'Criticality', 'Expected Nameservers', 'Expected Host', 'Notes'];\nconst lines = fields.filter(f => String(row[f] ?? '').trim()).map(f => f + ': ' + String(row[f]).trim());\nconst profile = row.Domain\n  ? (lines.length ? lines.join('\\n') : 'Listed in the Domains tab with no details filled in.')\n  : 'Not listed in the Domains tab.';\nreturn [{ json: { ...m, profile } }];"},"name":"Attach profile","type":"n8n-nodes-base.code","typeVersion":2,"position":[144,-912],"id":"e57331ce-f6e4-48b6-9484-d8d152f1f825"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"fix-to-apply","leftValue":"={{ $('Check decision').first().json['Status'] === 'Approved' && !!$('Check decision').first().json.fix_json }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"name":"Fix to apply?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[80,-48],"id":"0c95f765-1610-4942-bcd8-9ef55a6c51d0"},{"parameters":{"jsCode":"// Hand the approved fix to the apply-fix workflow.\nconst d = $('Check decision').first().json;\nreturn [{ json: { fix: d.fix_json, domain: d.domain, approval_id: d['Approval ID'], incident_id: d.incident_id } }];"},"name":"Prepare fix","type":"n8n-nodes-base.code","typeVersion":2,"position":[304,-160],"id":"c883de2e-25fc-4858-8295-cc3d22e935cb"},{"parameters":{"workflowId":{"__rl":true,"value":"c5iSqayHGx4KWmza","mode":"list","cachedResult